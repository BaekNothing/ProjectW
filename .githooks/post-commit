#!/bin/sh
# Pin architecture doc reference commit SHA to the commit that just landed.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD)"
NEEDS=0

for path in $CHANGED; do
  case "$path" in
    Assets/Specification/*|Assets/Scripts/*|Assets/Tests/*|Assets/Editor/*|Assets/Resources/CaseReviewData/*)
      NEEDS=1
      break
      ;;
  esac
done

if [ "$NEEDS" -eq 0 ]; then
  exit 0
fi

python tools/sync_architecture_doc.py --finalize || exit 0

DOC="Assets/Specification/Architecture – ProjectW System Overview.md"
if git diff --quiet -- "$DOC"; then
  exit 0
fi

git add -- "$DOC"
git commit -m "docs: refresh architecture sync metadata [skip ci]" --no-verify >/dev/null 2>&1 || true
exit 0
