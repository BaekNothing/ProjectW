#!/bin/sh
# Refresh architecture doc Git sync block when tracked design/code paths change.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

STAGED="$(git diff --cached --name-only)"
NEEDS_SYNC=0

for path in $STAGED; do
  case "$path" in
    Assets/Specification/*|Assets/Scripts/*|Assets/Tests/*|Assets/Editor/*|Assets/Resources/CaseReviewData/*)
      NEEDS_SYNC=1
      break
      ;;
  esac
done

if [ "$NEEDS_SYNC" -eq 0 ]; then
  exit 0
fi

python tools/sync_architecture_doc.py || exit 1
git add "Assets/Specification/Architecture – ProjectW System Overview.md" 2>/dev/null || true
exit 0
