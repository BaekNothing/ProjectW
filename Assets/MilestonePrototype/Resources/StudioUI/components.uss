.ds-button {
    min-height: 44px;
    min-width: 92px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, scale, opacity;
    transition-duration: 110ms, 70ms, 110ms;
    transition-timing-function: ease-out;
}

.ds-button:hover { scale: 1.01 1.01; }
.ds-button:active { scale: 0.98 0.98; }
.ds-button:disabled { opacity: 0.42; }
.ds-button:focus, .text-button:focus, .icon-button:focus, .nav-button:focus {
    border-width: 2px;
    border-color: var(--focus-ring);
}
.button-primary { background-color: var(--accent); color: white; }
.button-primary:hover { background-color: rgb(0, 91, 224); }
.button-secondary { background-color: var(--surface-pressed); color: var(--text-primary); }
.button-secondary:hover { background-color: var(--accent-soft); }
.button-danger { background-color: var(--error-soft); color: var(--error); }

.text-button {
    min-height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-secondary);
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-radius: 10px;
    transition-property: background-color, color, opacity;
    transition-duration: 110ms;
    transition-timing-function: ease-out;
}
.text-button:hover { background-color: var(--surface-raised); color: var(--text-primary); }
.text-button:active { opacity: 0.72; }

.icon-button {
    width: 44px;
    height: 44px;
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 12px;
    background-color: var(--surface-panel);
    color: var(--text-primary);
    font-size: 19px;
    transition-property: background-color, scale, border-color;
    transition-duration: 110ms, 70ms, 110ms;
    transition-timing-function: ease-out;
}
.icon-button:hover { background-color: var(--accent-soft); border-color: var(--accent); }
.icon-button:active { scale: 0.96 0.96; }

.section-card, .metric-card {
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 14px;
    padding: 18px;
}

.section-card { margin-bottom: 14px; }
.section-card, .metric-card, .task-slot-card, .task-block-row {
    transition-property: border-color, background-color, opacity, translate;
    transition-duration: 110ms, 110ms, 240ms, 240ms;
    transition-timing-function: ease-out;
}
.section-title { font-size: 18px; -unity-font-style: bold; color: var(--text-primary); margin-bottom: 4px; }

.badge {
    align-self: flex-start;
    min-height: 24px;
    padding: 4px 9px;
    border-radius: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--surface-pressed);
    color: var(--text-secondary);
}

.badge-accent { background-color: var(--accent-soft); color: var(--accent); }
.badge-success { background-color: var(--success-soft); color: var(--success); }
.badge-warning { background-color: var(--warning-soft); color: var(--warning); }
.badge-error { background-color: var(--error-soft); color: var(--error); }
.badge-neutral { background-color: var(--surface-pressed); color: var(--text-secondary); }

.button-row { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.button-row > .ds-button { margin-right: 8px; }
.task-slot-card, .task-block-row {
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 12px;
    padding: 14px;
    margin-top: 10px;
}
.task-slot-card { border-left-width: 4px; border-left-color: var(--accent); }
.task-block-row { background-color: var(--surface-pressed); }
.assignment-row {
    flex-direction: row;
    align-items: stretch;
    margin-top: 6px;
}
.assignment-selector { width: 34%; margin-right: 8px; }
.assignment-summary {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-left;
}
.progress-group { margin-top: 12px; }
.progress-header { flex-direction: row; justify-content: space-between; margin-bottom: 5px; }
.progress-track { height: 7px; border-radius: 4px; background-color: var(--surface-pressed); overflow: hidden; }
.progress-fill { height: 7px; border-radius: 4px; background-color: var(--accent); }

.empty-state {
    min-height: 96px;
    padding: 28px;
    -unity-text-align: middle-center;
    color: var(--text-secondary);
    white-space: normal;
}

.modal-host { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.modal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 10, 18, 0.68);
    transition-property: opacity;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
}
.modal-overlay > .section-card {
    width: 460px;
    max-width: 90%;
    padding: 28px;
    transition-property: opacity, scale, translate;
    transition-duration: 150ms, 240ms, 240ms;
    transition-timing-function: ease-out;
}
.modal-overlay .ds-button { margin-top: 10px; }

.motion-page-enter { opacity: 0; translate: 0 8px; }
.motion-toast-enter { opacity: 0; translate: 0 10px; }
.motion-panel-enter { opacity: 0; translate: 8px 0; }
.motion-panel-exit { opacity: 0; translate: 8px 0; }
.motion-modal-enter > .modal-overlay { opacity: 0; }
.motion-modal-enter > .modal-overlay > .section-card { opacity: 0; scale: 0.98 0.98; translate: 0 8px; }

.reduce-motion .ds-button,
.reduce-motion .text-button,
.reduce-motion .icon-button,
.reduce-motion .nav-button,
.reduce-motion .section-card,
.reduce-motion .metric-card,
.reduce-motion .task-slot-card,
.reduce-motion .task-block-row,
.reduce-motion .modal-overlay,
.reduce-motion .modal-overlay > .section-card,
.reduce-motion .page-content,
.reduce-motion .notification-toast-host,
.reduce-motion .notification-panel {
    transition-duration: 0ms;
}
