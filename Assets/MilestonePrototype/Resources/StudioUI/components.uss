.ds-button {
    min-height: 44px;
    min-width: 92px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 0;
    border-radius: 10px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, scale, opacity;
    transition-duration: 120ms, 90ms, 120ms;
    transition-timing-function: ease-out;
}

.ds-button:hover { scale: 1.01 1.01; }
.ds-button:active { scale: 0.98 0.98; }
.ds-button:disabled { opacity: 0.42; }
.button-primary { background-color: var(--accent); color: white; }
.button-primary:hover { background-color: rgb(0, 91, 224); }
.button-secondary { background-color: var(--surface-pressed); color: var(--text-primary); }
.button-secondary:hover { background-color: var(--accent-soft); }
.button-danger { background-color: var(--error-soft); color: var(--error); }

.text-button {
    min-height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-secondary);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.icon-button {
    width: 44px;
    height: 44px;
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 12px;
    background-color: var(--surface-panel);
    color: var(--text-primary);
    font-size: 19px;
}

.section-card, .metric-card {
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 14px;
    padding: 18px;
}

.section-card { margin-bottom: 14px; }
.section-title { font-size: 18px; -unity-font-style: bold; color: var(--text-primary); margin-bottom: 4px; }

.badge {
    align-self: flex-start;
    min-height: 24px;
    padding: 4px 9px;
    border-radius: 12px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--surface-pressed);
    color: var(--text-secondary);
}

.badge-accent { background-color: var(--accent-soft); color: var(--accent); }
.badge-success { background-color: var(--success-soft); color: var(--success); }
.badge-warning { background-color: var(--warning-soft); color: var(--warning); }
.badge-error { background-color: var(--error-soft); color: var(--error); }
.badge-neutral { background-color: var(--surface-pressed); color: var(--text-secondary); }

.button-row { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.button-row > .ds-button { margin-right: 8px; }
.progress-group { margin-top: 12px; }
.progress-header { flex-direction: row; justify-content: space-between; margin-bottom: 5px; }
.progress-track { height: 7px; border-radius: 4px; background-color: var(--surface-pressed); overflow: hidden; }
.progress-fill { height: 7px; border-radius: 4px; background-color: var(--accent); }

.empty-state {
    min-height: 96px;
    padding: 28px;
    -unity-text-align: middle-center;
    color: var(--text-secondary);
    white-space: normal;
}

.modal-host { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.modal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 10, 18, 0.68);
}
.modal-overlay > .section-card { width: 460px; max-width: 90%; padding: 28px; }
.modal-overlay .ds-button { margin-top: 10px; }
