  m_Script: {fileID: 11500000, guid: 61a9fe18710f44bca837d5f617b44383, type: 3}
  m_Name: Text_TeaAudit
  m_EditorClassIdentifier: Scripts::ProjectW.IngameCore.CaseReview.LocalizedTextTable
  tableId: text.scenario.tea-audit
  defaultLanguageKey: ko
  defaultCountryCode: KR
  entries:
  - Key: scenario.tea-audit.line.001
    Values:
    - LanguageKey: ko
      CountryCode: KR
      Text: "\uAC10\uC0AC\uD300\uC774 \uBCF5\uB3C4 \uB05D\uC5D0\uC11C \uB2F9\uC2E0\uC744
        \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4."
    - LanguageKey: en
      CountryCode: US
      Text: The audit team is waiting at the end of the corridor.
  - Key: scenario.tea-audit.line.002
    Values:
    - LanguageKey: ko
      CountryCode: KR
      Text: "\uCC28\uB098 \uD55C\uC794 \uD558\uC2DC\uC8E0. \uACF5\uC2DD \uAE30\uB85D\uC5D0\uB294
        \uB0A8\uAE30\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    - LanguageKey: en
      CountryCode: US
      Text: Let's have tea. I will keep it off the formal record.
  - Key: scenario.tea-audit.choice.listen
    Values:
    - LanguageKey: ko
      CountryCode: KR
      Text: "\uB05D\uAE4C\uC9C0 \uB4E3\uB294\uB2E4"
    - LanguageKey: en
      CountryCode: US
      Text: Listen to the end
  - Key: scenario.tea-audit.choice.alert
    Values:
    - LanguageKey: ko
      CountryCode: KR
      Text: "\uC0AC\uC7A5\uC5D0\uAC8C \uBA3C\uC800 \uC54C\uB9B0\uB2E4"
    - LanguageKey: en
      CountryCode: US
      Text: Alert the boss first
